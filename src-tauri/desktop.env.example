# Leyline desktop runtime configuration.
#
# The desktop app never ships a .env. Copy this file to `.env` in the same
# folder and fill in only what you need:
#   macOS:   ~/Library/Application Support/com.theaiinc.leyline/.env
#   Windows: %APPDATA%\com.theaiinc.leyline\.env
# Keys can also be set at runtime from the dashboard instead.
# See .env.example in the repository for what each setting does.

# Client bearer token for /v1/* (leave unset to auto-generate per session)
LEYLINE_CLIENT_API_KEY=
LEYLINE_CLIENT_AUTH_ENABLED=
LEYLINE_TUNNEL_ENABLED=

# Provider credentials
GEMINI_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEFAULT_MODEL=
AZURE_OPENAI_API_VERSION=
DEEPGRAM_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLM_API_BASE_URL=
LLM_API_DEFAULT_MODEL=

# LiteLLM proxy
LITELLM_ENABLED=
LITELLM_BASE_URL=
LITELLM_MODEL=
LITELLM_API_KEY=

# Routing
LEYLINE_ROUTER_ENABLED=
LEYLINE_FIXED_PROVIDER=
LEYLINE_FIXED_MODEL=

# Arcana secret references (resolved at runtime, no raw secrets here)
LEYLINE_ARCANA_OPENAI_API_KEY_REF=
LEYLINE_ARCANA_OPENAI_API_URL_REF=
LEYLINE_ARCANA_JANUS_API_KEY_REF=
