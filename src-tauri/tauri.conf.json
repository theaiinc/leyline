{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leyline",
  "version": "1.3.3",
  "identifier": "com.theaiinc.leyline",
  "build": {
    "beforeDevCommand": "npm run dev:dashboard",
    "devUrl": "http://127.0.0.1:1420/dashboard/",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Leyline",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "../dist"
    ]
  }
}
