{
  "name": "@theaiinc/leyline",
  "version": "1.3.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "public",
    ".env.example",
    "leyline-logo.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && vite build && node -e \"require('fs').copyFileSync('dashboard/public/logo.png','public/logo.png')\"",
    "prestart": "tsc",
    "start": "node dist/index.js",
    "litellm:azure": "npm run build && node scripts/start-litellm-azure.mjs",
    "dev": "nodemon src/index.ts",
    "test": "jest",
    "dev:dashboard": "vite --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:desktop": "tsc && VITE_TAURI=true VITE_LEYLINE_API_BASE_URL=http://127.0.0.1:3417 vite build && node -e \"require('fs').copyFileSync('dashboard/public/logo.png','public/logo.png')\"",
    "prepare:sidecar-deps": "node scripts/prepare-sidecar-deps.mjs",
    "tauri:build": "tauri build"
  },
  "keywords": [],
  "author": "The AI Inc",
  "license": "MIT",
  "description": "The ultimate cost-optimizing LLM load balancer & gateway.",
  "repository": {
    "type": "git",
    "url": "https://github.com/theaiinc/leyline"
  },
  "homepage": "https://github.com/theaiinc/leyline",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.5",
    "axios": "^1.13.2",
    "cn": "^0.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "next-themes": "^0.4.6",
    "openai": "^6.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jest": "^30.2.0",
    "lucide-react": "^1.55.0",
    "nodemon": "^3.1.11",
    "radix-ui": "^1.7.0",
    "sonner": "^2.0.8",
    "supertest": "^7.1.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "wrangler": "^4.149.0"
  }
