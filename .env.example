# ── Server ────────────────────────────────────────────────────────────
PORT=3000
# Client Bearer token for /v1/chat/completions and /v1/route.
# Leave unset with Cloudflare tunnel enabled to generate a fresh random key per server session.
# LEYLINE_CLIENT_API_KEY=leyline
# Set to false to skip client auth validation
# LEYLINE_CLIENT_AUTH_ENABLED=false
# Start a Cloudflare quick tunnel on boot (requires cloudflared in PATH)
LEYLINE_TUNNEL_ENABLED=true
# LEYLINE_TUNNEL_BINARY=cloudflared
# LEYLINE_TUNNEL_TIMEOUT_MS=45000
# Max JSON body size for /v1/* and dashboard API (default 100mb; Express default is 100kb)
# LEYLINE_BODY_LIMIT=100mb

# ── Cloud Provider API Keys ───────────────────────────────────────────
GEMINI_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEFAULT_MODEL=gpt-5.5
# Legacy Azure deployment endpoint is also supported:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21
# You can also set/clear cloud provider API keys at runtime from /dashboard.
# Dashboard keys can be persisted in Apple Keychain, browser localStorage, or memory.
# .env keys are explicit startup config and take precedence over Keychain on startup.
# Arcana references are read first when configured; Keychain remains the local fallback.
# Example: LEYLINE_ARCANA_OPENAI_REF=arcana://openai/api-key
# OpenAI-specific aliases:
# LEYLINE_ARCANA_OPENAI_API_KEY_REF=arcana://llmapi/arion/api-key
# LEYLINE_ARCANA_OPENAI_API_URL_REF=arcana://llmapi/arion/api-url
# Optional Janus API credential reference:
# LEYLINE_ARCANA_JANUS_API_KEY_REF=arcana://janus/api-key
# Generic account mapping is also supported as JSON:
# LEYLINE_ARCANA_SECRET_REFS={"api-key:OpenAI":"arcana://openai/api-key"}
LEYLINE_ARCANA_OPENAI_REF=
LEYLINE_ARCANA_GEMINI_REF=
LEYLINE_ARCANA_HF_REF=
LEYLINE_ARCANA_OPENROUTER_REF=
LEYLINE_ARCANA_AZURE_OPENAI_REF=
LEYLINE_ARCANA_COMMAND=arcana
LEYLINE_ARCANA_RUNNER=python3
LEYLINE_ARCANA_TIMEOUT_MS=10000
LEYLINE_KEYCHAIN_ENABLED=true
LEYLINE_KEYCHAIN_SERVICE=@theaiinc/leyline

# Arcana Cloud (services/arcana-cloud) — for headless deployments with no OS
# keychain and no local Arcana daemon (e.g. Leyline on Render). Takes
# precedence over the LEYLINE_ARCANA_* local-CLI refs above when configured.
# Requires an Aegis client_credentials client scoped to arcana:pull for THIS
# Leyline deployment's tenant, and the arcana-cloud workspaceId that secret
# was pushed into. References use arcana-cloud://<project>/<secretName>.
# LEYLINE_ARCANA_CLOUD_URL=https://arcana-cloud.theaiinc.com
# LEYLINE_ARCANA_CLOUD_AEGIS_URL=https://id.theaiinc.com
# LEYLINE_ARCANA_CLOUD_WORKSPACE_ID=
# LEYLINE_ARCANA_CLOUD_CLIENT_ID=
# LEYLINE_ARCANA_CLOUD_CLIENT_SECRET=
# Only needed if Cloudflare Access sits in front of arcana-cloud:
# LEYLINE_ARCANA_CLOUD_ACCESS_CLIENT_ID=
# LEYLINE_ARCANA_CLOUD_ACCESS_CLIENT_SECRET=
# LEYLINE_ARCANA_CLOUD_TIMEOUT_MS=10000
# LEYLINE_ARCANA_CLOUD_OPENAI_REF=arcana-cloud://leyline/openai-api-key
# LEYLINE_ARCANA_CLOUD_GEMINI_REF=
# LEYLINE_ARCANA_CLOUD_HF_REF=
# LEYLINE_ARCANA_CLOUD_OPENROUTER_REF=
# LEYLINE_ARCANA_CLOUD_AZURE_OPENAI_REF=
# LEYLINE_ARCANA_CLOUD_OPENAI_API_KEY_REF=
# LEYLINE_ARCANA_CLOUD_OPENAI_API_URL_REF=
# LEYLINE_ARCANA_CLOUD_JANUS_API_KEY_REF=
# Generic account mapping is also supported as JSON:
# LEYLINE_ARCANA_CLOUD_SECRET_REFS={"api-key:OpenAI":"arcana-cloud://leyline/openai-api-key"}

# ── Cloud Provider Quotas ─────────────────────────────────────────────
# Leyline-side RPM/RPD caps. Disabled by default — enable only for budget protection.
# LEYLINE_QUOTAS_ENABLED=true
GEMINI_QUOTA_RPM=10
GEMINI_QUOTA_RPD=1000
HF_QUOTA_RPM=100
HF_QUOTA_RPD=1000
OPENAI_QUOTA_RPM=60
OPENAI_QUOTA_RPD=1000
OPENROUTER_QUOTA_RPM=20
OPENROUTER_QUOTA_RPD=200
AZURE_OPENAI_QUOTA_RPM=60
AZURE_OPENAI_QUOTA_RPD=1000

# ── Local Model (LM Studio / OpenAI-compatible) ───────────────────────
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=

# ── LiteLLM Proxy (recommended Azure adapter for Cursor Agent) ─────────
# Run: npm run litellm:azure
# This starts LiteLLM on :4000 using AzureOpenAI key/runtime settings from env or Keychain.
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MODEL=gpt-5.5
LITELLM_API_KEY=not-needed
# Tell LiteLLM which Azure base model/context window to use for token accounting.
# The generated LiteLLM config also disables response caching.
LITELLM_BASE_MODEL=azure/gpt-5.5
# Cursor + Azure default for gpt-5.5-scale context. Lower these only to enforce a local budget.
LITELLM_MAX_INPUT_TOKENS=128000
LITELLM_MAX_OUTPUT_TOKENS=16384
# Leyline preflights the full JSON payload, including Cursor tools, using this chars/token estimate.
LITELLM_TOKEN_CHAR_RATIO=4
# Safe metadata-only audit of inbound vs outbound LiteLLM payloads; no prompt text is logged.
# LITELLM_PAYLOAD_AUDIT=true
# Optional Leyline-side rough JSON-size guard. Off by default to match direct Azure behavior.
# LEYLINE_LITELLM_PREFLIGHT_ENABLED=true

# ── Router / Classifier Model ─────────────────────────────────────────
# The lightweight model used to classify requests (complexity/domain/reasoning).
# Example: arch-router-1.5b.gguf
LEYLINE_ROUTER_MODEL=
LEYLINE_ROUTER_MAX_TOKENS=64
LEYLINE_ROUTER_TEMPERATURE=0
# Base URL for the LLM endpoint that hosts the router model
LEYLINE_OPENAI_BASE_URL=http://localhost:1234/v1

# Disable dynamic routing/failover and send every chat completion to one model.
# Recommended for Cursor + Azure OpenAI:
LEYLINE_ROUTER_ENABLED=false
LEYLINE_FIXED_PROVIDER=LiteLLM
LEYLINE_FIXED_MODEL=gpt-5.5
# Set LEYLINE_ROUTER_ENABLED=true to re-enable multi-provider failover.
# LEYLINE_FIXED_PROVIDER=
# LEYLINE_FIXED_MODEL=

# Optional model pool for auto routing: provider name -> model ids (JSON).
# When set, "model": "auto" only routes between these models; providers without
# an entry are skipped. Unset (or empty) routes across all models.
# The dashboard Routing card manages the same pool at runtime (persisted in Keychain,
# which overrides these env defaults once saved).
# LEYLINE_ENABLED_MODELS={"OpenAI":["gpt-5.5"],"Ollama":["llama2"]}

# Local Ollama is opt-in — enable only when you want Leyline to fail over to localhost:11434.
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=llama2

# ── Tier → Model Resolution ───────────────────────────────────────────
# Maps tier labels to actual model names.
# These are the model names used by the code policy for route resolution.
LEYLINE_MODEL_2B=
LEYLINE_MODEL_4B=
LEYLINE_MODEL_12B=

# ── Custom Model Variants Registry (JSON) ─────────────────────────────
# If set, leyline uses these variants INSTEAD of the built-in defaults.
# This lets consumers define their own model catalog (names, providers,
# capabilities, billing, etc.) without modifying leyline source.
#
# Format: JSON array of ModelVariant objects.
# Example:
# LEYLINE_CUSTOM_VARIANTS=[{"id":"google/gemma-4-12b","name":"Gemma 4 12B","family":"gemma-4","provider":"openai","source":"lmstudio","parameter_size_b":12,"quantization":"Q4_K_M","context_length":262144,"capabilities":{"tools":true,"thinking":true,"vision":true,"code":true,"embedding":false},"billing_class":"free_local","resource_class":"standard"}]
LEYLINE_CUSTOM_VARIANTS=

# ── Prompt Compression (@theaiinc/headroom-ai, optional) ────────────────
# Fork of chopratejas/headroom, library-only (no proxy).
# Install: pip install headroom-ai
#
# Uses the `headroom-compress` CLI or falls back to `python3 -m headroom.json_cli`.
# Passes messages as JSON on stdin, receives compressed messages as JSON on stdout.
LEYLINE_COMPRESSION_ENABLED=false
LEYLINE_COMPRESSION_MODEL=
LEYLINE_COMPRESSION_TOKEN_BUDGET=

# ── Aegis-verified hosted mode (Render) ──────────────────────────────
# For the multi-tenant hosted deployment: verifies Bearer tokens as Aegis
# (id.theaiinc.com) RFC 8693 token-exchange JWTs instead of the single
# static LEYLINE_CLIENT_API_KEY, and meters/rate-limits per calling app
# (the token's requester_client_id). Not used by the local/desktop app —
# leave unset there. See render.yaml for the full hosted deployment config.
# LEYLINE_AEGIS_AUTH_ENABLED=true
# Issuer of Leyline's own Aegis tenant (JWKS is fetched from `${issuer}/jwks`).
# LEYLINE_AEGIS_ISSUER=https://<leyline-tenant>.id.theaiinc.com
# Leyline's own Aegis OAuth client id (the expected `aud` claim).
# LEYLINE_AEGIS_CLIENT_ID=
# Default per-tenant (per requester_client_id) request caps.
# LEYLINE_TENANT_DEFAULT_RPM=60
# LEYLINE_TENANT_DEFAULT_RPD=5000
