{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Hosted Leyline: the LLM API people's coding agents use with keys the owner hands out, and the dashboard.
  // worker/index.ts runs the same Express app as the Node server; README "Hosted keys" has the setup.
  "name": "leyline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run in Singapore, not wherever the request lands: from Cloudflare's Hong Kong colo (where most of our traffic
  // lands) Anthropic's API answers 403 "Request not allowed", Hong Kong being outside its supported regions.
  // Singapore is supported and close to the D1 primary (HKG).
  "placement": { "mode": "targeted", "region": "gcp:asia-southeast1" },
  // Not leyline.theaiinc.com (the Leyline Aegis tenant's issuer domain) or leyline-api.theaiinc.com (the Render
  // deployment, render.yaml).
  "routes": [
    { "pattern": "llm.valefront.com", "custom_domain": true },
    { "pattern": "llm.theaiinc.com", "custom_domain": true },
    { "pattern": "dash.valefront.com", "custom_domain": true },
    // Billing admin (src/core/admin-billing.ts): behind a Cloudflare Access application, plus the app's own check.
    { "pattern": "adm.valefront.com", "custom_domain": true }
  ],
  // The invoice/receipt font (src/core/billing-documents.ts), bundled as an ArrayBuffer.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  // The dashboard's files (vite build). The Worker runs first so it can keep the page behind sign-in.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "leyline", "database_id": "b7050bcf-f9ed-40bb-9042-b78ceb88fb22", "migrations_dir": "worker/migrations" }
  ],
  // Daily benchmarks and cleanup; every 15 minutes the VAT e-invoice retry job (worker/index.ts scheduled()).
  "triggers": { "crons": ["23 4 * * *", "*/15 * * * *"] },
  // Workers AI (src/providers/workers-ai.ts): @cf/ chat, embeddings, Whisper and MeloTTS without an API token.
  "ai": { "binding": "AI" },
  // Cost alerts by email (Cloudflare Email Sending, onboarded for notify.theaiinc.com: theaiinc.com's own mail is
  // Google's, so alerts come from a subdomain of their own).
  // Invoices and receipts come from billing@valefront.com (BILLING_FROM): valefront.com must be onboarded too.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["alerts@notify.theaiinc.com", "billing@valefront.com"] }],
  "vars": {
    "LEYLINE_HOSTED_KEYS": "on",
    "LEYLINE_PUBLIC_URL": "https://llm.valefront.com",
    "LEYLINE_PUBLIC_ALIASES": "https://llm.theaiinc.com,https://dash.valefront.com",
    "LEYLINE_KEYCHAIN_ENABLED": "false",
    "LEYLINE_TUNNEL_ENABLED": "false",
    "LEYLINE_LOGIN_ISSUER": "https://id.theaiinc.com",
    "LEYLINE_LOGIN_CLIENT_ID": "leyline-dashboard",
    "LEYLINE_ADMIN_EMAILS": "stevetran.dev@gmail.com,steve.tran@theaiinc.com",
    // What all keys together may spend a month until it's changed on the dashboard (Offered models → Spending).
    "LEYLINE_MONTHLY_BUDGET_USD": "50",
    "LEYLINE_ALERT_FROM": "Leyline <alerts@notify.theaiinc.com>",
    "LLM_API_BASE_URL": "https://api.llmapi.ai/v1",
    // Arcana Cloud: providers can take keys from arcana://<project>/<name> references (project "leyline" is granted
    // to the Aegis machine client leyline-arcana, Arcana tenant). arcana-cloud sits behind Cloudflare Access; the
    // service token leyline-arcana-cloud gets through.
    "LEYLINE_ARCANA_CLOUD_WORKSPACE_ID": "a8006a7d-86fc-4d31-8610-9abbee59df8c",
    "LEYLINE_ARCANA_CLOUD_CLIENT_ID": "leyline-arcana",
    "LEYLINE_ARCANA_CLOUD_ACCESS_CLIENT_ID": "244a58ae2f80c912e197671796f88573.access",
    // Billing (README "Self-serve sign-up and billing"). Sandbox | Live for PayPal and Viettel S-Invoice is switched on
    // adm.valefront.com, not here.
    "BILLING_FROM": "Valefront Billing <billing@valefront.com>",
    "ADMIN_HOST": "adm.valefront.com",
    // Turnstile widget "Valefront sign-up" (its secret is the TURNSTILE_SECRET Worker secret); the valefront.com
    // partner form uses it too.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF0as-gnh67yvrdS",
    // Access application "Valefront billing admin" on adm.valefront.com (allow: LEYLINE_ADMIN_EMAILS).
    "CF_ACCESS_TEAM_DOMAIN": "https://rough-cell-0ce1.cloudflareaccess.com",
    "CF_ACCESS_AUD": "f370c1fed138edae3fed542b2ffa0e862cb36fccc881a2c226dea61e0c4785df",
    // Free tier (launch, 2026-11-05): 1M tokens at sign-up + 4M unlocked by the first top-up, 30 days, DeepSeek V4 Flash only, at
    // most 250k a day per workspace (so the 5M can be used within the 30 days); 20M a day across all (the default).
    "FREE_TIER_MODELS": "deepseek-v4-flash-ga-260731",
    "FREE_TIER_TOKENS_PER_DAY": "250000"
    // Optional vars: CF_ACCESS_SERVICE_TOKEN_IDS, FREE_TIER_GLOBAL_TOKENS_PER_DAY, PARTNER_INQUIRY_TO (where the
    // valefront.com "Partner with Valefront" inquiries are emailed, from billing@valefront.com; default
    // info@valefront.com; src/core/partner-inquiries.ts, migration 0004_partner_inquiries.sql).
  }
  // Secrets (wrangler secret put): LEYLINE_STORE_KEY (32 random bytes, base64), LEYLINE_SESSION_SECRET,
  // LEYLINE_LOGIN_CLIENT_SECRET, LLM_API_KEY, LEYLINE_ARCANA_CLOUD_CLIENT_SECRET,
  // LEYLINE_ARCANA_CLOUD_ACCESS_CLIENT_SECRET; optionally LEYLINE_ADMIN_TOKEN, and provider keys such as
  // OPENAI_API_KEY or DEEPGRAM_API_KEY (or save them on the dashboard / as Arcana references instead);
  // BYTEPLUS_VISION_ACCESS_KEY_ID + BYTEPLUS_VISION_SECRET_ACCESS_KEY turn on OmniHuman talking avatars.
  // Billing secrets: TURNSTILE_SECRET; per mode (SANDBOX and LIVE side by side): PAYPAL_{SANDBOX,LIVE}_CLIENT_ID,
  // _CLIENT_SECRET, _WEBHOOK_ID; VIETTEL_SINVOICE_{SANDBOX,LIVE}_USERNAME, _PASSWORD, _TAX_CODE, _TEMPLATE_CODE,
  // _SERIES (optionally _BASE_URL, _AUTH_URL).
}
